{
	"name": "@okdaichi/media-devices",
	"version": "0.1.0",
	"exports": {
		".": "./mod.ts"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/okdaichi/moqrtc-js",
		"directory": "packages/media_devices"
	},
	"description": "Device management for real-time media apps: device enumeration, permission caching, device selection, device-change tracking, and per-track lifecycle management.",
	"keywords": [
		"webrtc",
		"mediadevices",
		"media",
		"camera",
		"microphone",
		"getusermedia",
		"getdisplaymedia"
	],
	"compilerOptions": {
		"lib": ["ESNext", "deno.ns", "DOM", "dom.iterable", "dom.asynciterable"],
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"verbatimModuleSyntax": true
	},
	"tasks": {
		"check": "deno check **/*.ts",
		"test": "deno test --allow-all",
		"publish": "deno publish"
	},
	"fmt": {
		"useTabs": true,
		"lineWidth": 100,
		"indentWidth": 4,
		"singleQuote": false,
		"semiColons": true,
		"proseWrap": "preserve"
	},
	"lint": {
		"rules": {
			"tags": ["recommended"],
			"exclude": ["require-await"]
		}
	},
	"publish": {
		"exclude": [
			"**/*_test.ts"
		]
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@^1.0.19"
	}
}
